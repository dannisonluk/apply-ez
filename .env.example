# ─── Supabase ─────────────────────────────────────────────────────────────────
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key. Server-side only — never ship this to the app or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Scraper behaviour ────────────────────────────────────────────────────────
LOG_LEVEL=info
# Politeness: minimum gap between requests, and max parallel requests.
SCRAPER_MIN_TIME_MS=1000
SCRAPER_MAX_CONCURRENT=2
# Consecutive full-crawl misses before a job is marked EXPIRED.
SCRAPER_EXPIRE_AFTER_MISSING_RUNS=2
# Optional: route Playwright through a single upstream proxy.
PROXY_URL=

# ─── LLM enrichment layer (OpenRouter) ────────────────────────────────────────
# Summarises each NEW job and extracts deadline / YOE / skills / flags.
# Leave OPENROUTER_API_KEY empty to skip the layer entirely — the scraper still runs.
#
# ⚠ Free models require enabling prompt logging/training in OpenRouter settings,
#   which means prompts are retained and may be used for training. Only PUBLIC job
#   posting text is ever sent here. NEVER send resumes or profile data.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
# Free tier: <10 credits lifetime = 50 req/day; >=10 credits = 1,000 req/day.
# One US$10 top-up is enough for a 30-jobs/day workload with large headroom.
# Hard ceiling per target per run, so one big full crawl cannot drain the daily quota.
OPENROUTER_MAX_JOBS_PER_RUN=40
OPENROUTER_CONCURRENCY=2
# Minimum gap between LLM requests (ms) across all workers.
OPENROUTER_MIN_TIME_MS=1200
OPENROUTER_TIMEOUT_MS=90000
# Postings shorter than this are not worth an LLM call.
OPENROUTER_MIN_DESCRIPTION_CHARS=200

# ─── Push notifications ───────────────────────────────────────────────────────
# Sends an Expo push after a run finds new jobs. Requires at least one device to
# have registered in the app (see supabase/migrations/0002_push_tokens.sql).
# Set to false to silence notifications without touching the app.
PUSH_ENABLED=true
# Only needed if you enabled "Enhanced Push Security" on the Expo project.
EXPO_ACCESS_TOKEN=

# ─── Relevance filter ─────────────────────────────────────────────────────────
# Every job is scored 0-100 against one profile — Data Analyst / Business Analyst /
# Software Engineering, at 2-3 years of experience (see src/lib/relevance.ts). The
# score is a pure function of the posting: no resume or profile data is involved.
#
# Nothing is ever dropped: low scorers are still written with the reason attached,
# and the app decides what to display. This value only controls the counts reported
# in the run summary — the app's own threshold lives in Settings.
#
# To see what the filter hides and why, against a live board:
#   pnpm --filter @apply-ez/scraper-core why:filtered axa
JOB_MIN_RELEVANCE=35

# ─── Adapter tuning ───────────────────────────────────────────────────────────
# Cathay's listing cards carry no description and no deadline, so each job's detail
# page is fetched. Roughly 45 requests per run, paced by SCRAPER_MIN_TIME_MS.
CATHAY_DETAIL_CONCURRENCY=3
# Set to false to skip the detail stage (jobs then have no summary or deadline).
# CATHAY_FORCE_HTTP=false

# ─── Application codes ────────────────────────────────────────────────────────
# Two gates, both verified server-side against bcrypt hashes in Supabase. They are
# NEVER shipped to the app, so a stolen APK reveals nothing.
#
#   UNLOCK_APPLICATION_CODE   opens the application area and the history
#   BEFORE_APPLICATION_CODE   required on every single submit — deliberate friction
#                             so a stray tap can never file a real application
#
# After filling these in, push the hashes to Supabase once (and again whenever you
# rotate a code):
#
#   pnpm --filter @apply-ez/scraper-core sync:codes
#
# Leaving one blank leaves that code unchanged on the server.
UNLOCK_APPLICATION_CODE=
BEFORE_APPLICATION_CODE=

GITHUB_PERSONAL_ACCESS_TOKEN=

WORKBUDDY_EXPO_DEV_API_TOKEN=