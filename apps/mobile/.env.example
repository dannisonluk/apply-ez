# Expo inlines EXPO_PUBLIC_* variables into the bundle at build time.
#
# The anon key is safe to ship: it is public by design and every table it can
# reach is guarded by RLS (see supabase/migrations/0001_init.sql). The
# service-role key must NEVER appear in this file — it belongs only in the
# scraper's GitHub Actions secrets.
#
# Find both values in the Supabase dashboard under Project Settings -> API.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
