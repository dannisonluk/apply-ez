{
  "name": "@apply-ez/scraper-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone job scraper core: adapters, normalization pipeline, and Supabase ingest",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium",
    "scrape": "tsx src/cli.ts",
    "scrape:dry": "tsx src/cli.ts --dry-run",
    "sync:codes": "tsx scripts/sync-codes.ts",
    "probe:cathay": "tsx scripts/probe-cathay.ts",
    "probe:target": "tsx scripts/probe-target.ts",
    "probe:robots": "tsx scripts/probe-robots.ts",
    "why:filtered": "tsx scripts/why-filtered.ts",
    "check": "tsx scripts/check-backfill.ts && tsx scripts/check-hk-time.ts && tsx scripts/check-relevance.ts && tsx scripts/check-llm.ts && tsx scripts/check-push.ts && tsx scripts/check-store.ts && tsx scripts/check-http.ts && tsx scripts/check-workday.ts && tsx scripts/check-platform-adapters.ts",
    "check:backfill": "tsx scripts/check-backfill.ts",
    "check:hk-time": "tsx scripts/check-hk-time.ts",
    "check:relevance": "tsx scripts/check-relevance.ts",
    "check:llm": "tsx scripts/check-llm.ts",
    "check:push": "tsx scripts/check-push.ts",
    "check:store": "tsx scripts/check-store.ts",
    "check:http": "tsx scripts/check-http.ts",
    "check:workday": "tsx scripts/check-workday.ts",
    "check:platform": "tsx scripts/check-platform-adapters.ts"
  },
  "dependencies": {
    "bottleneck": "^2.19.5",
    "pino": "^9.6.0",
    "playwright": "^1.50.0",
    "robots-parser": "^3.0.1",
    "undici": "^6.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
